<?xml version="1.0" encoding="UTF-8"?>
<templates id="custom_model_access_management_button_template" xml:space="preserve">
    <t t-name="custom_model_access_management.AddButtonDialog">
        <Dialog title.translate="Select Buttons">
            <div class="o_inner_wizard">
               <div class="o_list_renderer o_renderer table-responsive" tabindex="-1">
                   <table class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer" tabindex="-1" style="width: 40px;">
                                    <div class="o-checkbox form-check d-flex m-0">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   t-model="state.selectAll"
                                                   t-on-click="toggleSelectAll"/>
                                            <label class="form-check-label"/>
                                        </div>
                                </th>
                                <th class="align-middle o_column_sortable position-relative cursor-pointer opacity-trigger-hover w-print-auto" tabindex="-1" style="width: 40px;" data-name="string">
                                    <div class="d-flex">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Button Name</span>
                                    </div>
                                </th>
                                <th class="align-middle o_column_sortable position-relative cursor-pointer opacity-trigger-hover w-print-auto" tabindex="-1" style="width: 40px;" data-name="name">
                                    <div class="d-flex">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Technical Name</span>
                                    </div>
                                </th>
                                <th class="align-middle o_column_sortable position-relative cursor-pointer opacity-trigger-hover w-print-auto" tabindex="-1" style="width: 40px;" data-name="name">
                                    <div class="d-flex">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">Button Type</span>
                                    </div>
                                </th>
                                <th class="align-middle o_column_sortable position-relative cursor-pointer opacity-trigger-hover w-print-auto" tabindex="-1" style="width: 40px;" data-name="name">
                                    <div class="d-flex">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1">View Type</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="ui-sortable">
                            <t t-if="state.buttons_data.length">
                                <tr t-foreach="state.buttons_data" t-as="rec"   t-key="rec._key">
<!--                                <tr t-foreach="state.buttons_data" t-as="rec" t-key="rec.technical_name and rec.type and rec.view_type">-->
                                    <td class="o_list_record_selector user-select-none">
                                        <div class="o-checkbox form-check">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   t-att-id="'checkbox-' + rec.name"
                                                   t-model="rec.selected" />
                                            <label class="form-check-label"
                                                   t-att-for="'checkbox-' + rec.name"/>
                                        </div>
                                    </td>
                                    <td><t t-esc="rec.name"/></td>
                                    <td><t t-esc="rec.technical_name"/></td>
                                    <td><t t-esc="rec.type"/></td>
                                    <td><t t-esc="rec.view_type"/></td>
                                    <td style="display: none;"><t t-esc="props.context.model_access_id"/></td>
                                </tr>
                            </t>
                        </tbody>
                   </table>
               </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="SelectedRecords">select</button>
                <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>







