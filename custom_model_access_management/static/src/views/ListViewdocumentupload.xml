<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-inherit="account.FileuploadListView.Buttons" t-inherit-mode="extension"
       t-name="account.FileuploadListView.Buttons.Inherit">
        <xpath expr="//t[@t-call='account.DocumentViewUploadButton']" position="replace">
            <t t-if="!archInfo.custom_active_Action.upload_access">
                <t t-call="account.DocumentViewUploadButton"/>
            </t>
        </xpath>
    </t>
    <t t-inherit="account.FileuploadKanbanView.Buttons" t-inherit-mode="extension"
       t-name="account.FileuploadKanbanView.Buttons.Inherit">
        <xpath expr="//t[@t-call='account.DocumentViewUploadButton']" position="replace">
            <t t-if="!props.archInfo.custom_active_Action.upload_access">
                <t t-call="account.DocumentViewUploadButton"/>
            </t>
        </xpath>
    </t>

    <t t-inherit="account.AccountViewUploadButton" t-inherit-mode="extension" t-name="AccountViewUploadButtonInherit">
        <xpath expr="//AccountFileUploader/t/button" position="attributes">
            <attribute name="t-if">!props.archInfo.custom_active_Action.upload_access</attribute>
        </xpath>
    </t>

    <t t-name="custom_model_access_management.ListRenderer.Rows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="extension">
        <xpath expr="//t/tr[1]/td[2]" position="inside">
            <t t-if="props.list._config.resModel == 'model_header_button' and this.env.model.config.resId">
                <button type="button" class="btn btn-Secondary" style="margin-right: 10px; cursor: pointer; color: #875e8f; text-decoration: none;"
                        t-on-click="OnAddButtonClick">
                    Select Buttons
                </button>
            </t>
        </xpath>
    </t>
</templates>
