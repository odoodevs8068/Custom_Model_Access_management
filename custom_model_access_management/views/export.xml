<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ir_exports_view_tree" model="ir.ui.view">
        <field name="name">ir_exports_view_tree</field>
        <field name="model">ir.exports</field>
        <field name="arch" type="xml">
            <list multi_edit="1" create="0">
                <field name="name"/>
                <field name="user_ids"  widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="ir_exports_view_form" model="ir.ui.view">
        <field name="name">ir_exports_view_form</field>
        <field name="model">ir.exports</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="resource" />
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="export_fields"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_exports" model="ir.actions.act_window">
        <field name="name">Exports Templates</field>
        <field name="res_model">ir.exports</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="ir_exports_view_tree"/>
    </record>


    <record id="access_right_export_fields_view_tree" model="ir.ui.view">
        <field name="name">access_right_export_fields_view_tree</field>
        <field name="model">model_access.right</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="type"/>
                <field name="field_id"/>
                <field name="user_ids"  widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="access_right_export_fields_action" model="ir.actions.act_window">
        <field name="name">Restrict Export Fields</field>
        <field name="res_model">model_access.right</field>
        <field name="view_mode">list</field>
        <field name="context">{'default_type' : 'show_field'}</field>
        <field name="domain">[('type' , '=', 'show_field')]</field>
        <field name="view_id" ref="access_right_export_fields_view_tree"/>
    </record>

    <menuitem
            id="ir_exports_menu_action"
            name="Export Restrictions"
            parent="custom_model_access_management.access_right_main_menu"
            sequence="5">
        <menuitem
                id="ir_exports_Templates_menu_action"
                name="Export Templates"
                action="action_ir_exports"
                sequence="10"/>
        <menuitem
                id="ir_exports_field_menu_action"
                name="Export Fields"
                action="access_right_export_fields_action"
                sequence="5"/>
    </menuitem>

</odoo>